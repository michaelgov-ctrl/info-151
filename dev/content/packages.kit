<section id="packages">
    <div id="packages-top-content">
        <h1 class="section-title">Po<span><img src="img/global/green-icon.svg" alt="part of a green outline"></span>pular packages</h1>

        <div id="package-button-container">
            <button id="left-arrow"><img src="img/packages/arrow-left.svg" alt="left chevron icon"></button>
            <button id="right-arrow"><img src="img/packages/arrow-right.svg" alt="right chevron icon"></button>
        </div>
    </div>

    <ul id="package-card-container">

        <li class="package-card" id="card-1">
            <div class="package-card-img"></div>
            <p>The basic package to start your promotion</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>
                </ul>
                <h4>200K+ users</h4>
                <h3>$89.00</h3>
            </div>

        </li>

        <li class="selected package-card" id="card-2">
            <div class="package-card-img"></div>
            <p>The standard package to grow your business</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>

                </ul>
                <h4>140K+ users</h4>
                <h3>$109.00</h3>
            </div>

        </li>

        <li class="package-card" id="card-3">       
            <div class="package-card-img"></div>
            <p>The premium package to boost your promotion</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>
                </ul>
                <h4>99K+ users</h4>
                <h3>$149.00</h3>
            </div>

        </li>

    </ul>
</section>
